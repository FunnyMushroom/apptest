{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C/C++: gcc 构建和调试",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/program",  // 要调试的程序路径
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: gcc 编译项目",  // 调试前先执行这个任务（编译）
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}