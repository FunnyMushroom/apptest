{
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: gcc 编译项目",
            "command": "gcc -fdiagnostics-color=always -g -o program $(find . -name '*.c' -not -path './.vscode/*') $(find . -name '*.h' -not -path './.vscode/*' -exec dirname {} \\; | sort -u | sed 's/^/-I/') -lpthread -lrt",
            "options": {
                "cwd": "/home/user/ceshi"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc 生成活动文件",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "-lpthread",
                "-lrt"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ],
    "version": "2.0.0"
}